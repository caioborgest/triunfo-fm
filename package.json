{
  "name": "triunfo-fm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @triunfo/web dev",
    "build": "pnpm db:generate && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" pnpm --filter @triunfo/web build",
    "start": "pnpm --filter @triunfo/web start",
    "lint": "pnpm --filter @triunfo/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @triunfo/database db:generate",
    "db:validate": "pnpm --filter @triunfo/database db:validate",
    "db:migrate": "pnpm --filter @triunfo/database db:migrate",
    "db:seed": "pnpm --filter @triunfo/database db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
